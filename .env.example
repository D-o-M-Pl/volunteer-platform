# PostgreSQL
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/volunteer_platform

# OIDC access-token validation (Entra External ID, Auth0, Keycloak, etc.)
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=volunteer-platform-api
AUTH_JWKS_URI=https://identity.example.com/.well-known/jwks.json

# AI provider
ANTHROPIC_API_KEY=

# API security
NODE_ENV=development
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_MAX=60
LOG_LEVEL=info

# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001
